# Dependencies & build output
node_modules/
dist/
runtime/
# Keep only reviewed license/source metadata for the independent bundled Node.
!/ruyi-workbench/runtime/
/ruyi-workbench/runtime/*
!/ruyi-workbench/runtime/node/
/ruyi-workbench/runtime/node/*
!/ruyi-workbench/runtime/node/LICENSE
!/ruyi-workbench/runtime/node/NOTICE.md
!/ruyi-workbench/runtime/node/SHASUMS256.txt
!/ruyi-workbench/runtime/node/provenance.lock.json

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Offline wheels (shipped via GitHub Release assets, not git)
wheels/
offline_wheels/
/mcp/ai-computer-control/build/
/mcp/ai-computer-control/build_offline/

# Tooling / local state(云端会话钩子与共享设置入库,其余本地状态照旧忽略)
.claude/*
!.claude/settings.json
!.claude/hooks/

# Local campaign drafts and generated marketing assets
/docs/marketing/

# Live model benchmark outputs (may contain local paths and provider responses)
/benchmark-results/

# Local acceptance fixtures and raw receipts; curated evidence belongs in docs.
/output/

# Archives & logs
*.zip
*.log

# OS cruft
.DS_Store
Thumbs.db
# Isolated Windows probes must not publish unresolved system-data fallbacks.
/%SystemDrive%/
# Unresolved Windows-generated state from isolated probes; never publish it.
/dev-harness/Microsoft/
# Unconsumed independent holdouts stay local until the frozen one-shot review.
/dev-harness/semantic/acceptance-v7*
/dev-harness/semantic/acceptance-zh-v1*

# 第29波监控冒烟测试隔离工作区(不入库)
/.wave29-livetest/
# A/B probe run artifacts (local benchmark outputs, may contain provider responses)
/dev-harness/ab-results/
# 105波真实历史实测:本机历史记录的只读副本(含会话内容,不入库)
/dev-harness/realhist-fixtures/
# 本机跑产品时的数据根(config.json / sessions / logs / memory / 生成物)——与上一条同理:
# 是【运行数据】不是源码,而且含真实会话与本机配置。此前它一直以未跟踪状态挂在 git status 里,
# 每次收工都要人肉确认一遍「这不是漏提交」,列进来省掉这道噪音。
/.ruyi-runtime/

# Desktop shell build outputs (source in ruyi-workbench/desktop/)
/.tmp-csc-probe/
/ruyi-workbench/RuyiDesktop.exe
/ruyi-workbench/WebView2Loader.dll

# bench-voice 的合成音频与假设产物(不进 git;README 说明如何重造)
dev-harness/bench-voice/wav/
dev-harness/bench-voice/wav_noisy/
dev-harness/bench-voice/wav_hard/
dev-harness/bench-voice/pwav/
dev-harness/bench-voice/pwav_noisy/
dev-harness/bench-voice/hyp/
dev-harness/bench-voice/phyp/
dev-harness/bench-voice/manifest.json
dev-harness/bench-voice/pmanifest.json
dev-harness/bench-voice/scores.json
dev-harness/bench-voice/pscores.json
