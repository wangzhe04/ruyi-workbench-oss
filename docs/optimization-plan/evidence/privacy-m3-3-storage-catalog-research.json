  "retained": [
    {
      "pattern": "sessions/<sid>.messages.ndjson.prevbody; <sid>.provider.ndjson.prevbody",
      "policy": "same session/kind/physicalOrdinal binding as original body; settle existing owner crash transaction first; never reconstruct from current head alone"
    },
    {
      "pattern": "agent-runs/<sid>/<rid>.events.ndjson.gz",
      "policy": "must decompress and authenticate/recode nested journal records on reverse migration, then recompress; whole binary envelope alone is insufficient to ensure OFF archive has no nested ciphertext"
    },
    {
      "pattern": "sessions/*.corrupt*; checkpoints/<sid>/index.json.corrupt-*; memory/**/*.corrupt*; missions/*.corrupt; scheduler/tasks-v1.json.corrupt",
      "policy": "opaque user-content evidence; preserve separately in sealed backup; cannot blindly parse/domain-normalize or delete; disclose if kept plaintext"
    },
    {
      "pattern": "*.tmp; *.sealed-stage-*; *.work-data-stage-*; migration capsule .ruyi-capsule-v1 intent/archive/objects/restored",
      "policy": "classify only through actual owning recovery protocol; never infer temp means safe to remove; authenticate and preserve uncertain state"
    },
    {
      "pattern": "migrations/skill-backups/<stamp>/<id>/objects/**",
      "policy": "same original NTFS objects needed; generic fs.cp destroys IDs/ACL/ADS/shortnames semantics. Must use native capsule lifecycle or portable export adapter explicitly."
    },
    {
      "pattern": "uploads/** and user skill source bodies",
      "policy": "not part of 41 frozen required families; full recovery inventory must cover and state media protection boundary. Do not silently omit from full package."
    }
  ],
  "transforms": {
    "wholeText": "WorkDataStore.createText with fixed catalog binding and host.file=source/shadow; source keys=old owned lease, target keys=new owned lease; enabled false/true supplied by transition, writeJson writes shadow only. Avoid create/createJson because prepare/sanitize/default/quarantine changes old payload. Hash logical UTF8 bytes before and after. Reject invalid UTF8 roundtrip rather than silently replacing bytes.",
    "binary": "WorkDataStore.createBinary preserves complete gzip bytes (encoding gzip-base64-v1). Reuse domain validateLegacyBinary. Source and destination explicit distinct files. Nested run-event gzip requires decoding inner records to target policy, not just envelope.",
    "sessionRecords": "WorkDataRecords.decodeLine / encodeLine for fixed original four kinds (schema2). Preserve physical ordinals INCLUDING blank lines and actual line terminators. decodeBody is all-sealed strict checker only; mixed legacy plain/cipher requires per-line classifier. Reconcile heads/prevbody through source session owner first; no uncommitted-tail promotion.",
    "auxRecords": "WorkDataRecords.decodeRecordLine / encodeRecordFactory; WorkDataJournals.create(...).readWindow(0,0,visit) for full authenticated visitor. Journal scan emits blank/bad legacy rows unchanged and each LF consumes ordinal. Existing replace validates domain rows and stages only canonical LF rows; not byte-preserving migration for arbitrary legacy evidence. Refuse uncertain/torn/no-LF reserved input or preserve in sealed retained backup after owner reconciliation. Important: invalid legacy rows may be ignored today but cannot be sealed into live stream because validateSealedLine then makes reads fail. Refuse migration pending explicit repair, or retain exact evidence in a sealed separate artifact and compact only through existing owner with explicit proof.",
    "capsule": "migrationCapsuleRead / migrationCapsuleVerifyReady / migrationCapsulePrepare / migrationUndoCapsule are specialized, original-object aware. Do not invoke them without complete owner plan; backup path dirname participates AAD. Cross-machine full recovery needs new portable representation or failure before target mutation."
  },
