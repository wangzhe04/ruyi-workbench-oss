  "finalPureReproduction": {
    "command": "node - <<'JS'\nconst fs=require('fs'),crypto=require('crypto'),path=require('path');\nconst {functionBlock}=require('./dev-harness/lib/source-slice');\nconst src=fs.readFileSync('ruyi-workbench/app/src/02-session-store.js','utf8');\nconst kinds=fs.readFileSync('ruyi-workbench/app/src/02f-turn-effect-kinds.js','utf8');\nconst region=src.slice(src.indexOf('const IRREVERSIBLE_COMPOUND_TOOLS'),src.indexOf('\\nfunction buildTurnSummary'));\nconst {project,summary}=new Function('crypto','Buffer','path',kinds+'\\n'+functionBlock(src,'asResultObject')+'\\n'+region+'\\n'+functionBlock(src,'buildTurnSummary')+'\\nreturn {project:projectBridgedIrreversible,summary:buildTurnSummary};')(crypto,Buffer,path);\nconst call=(tool,result,id='call')=>({id,name:'ai_computer_control__'+tool,input:{},result});\nconst positives={ok:true,action_sent:true};\nconst leaf=(step)=>({step,tool:'input_sequence',invocation_attempted:true,result:positives});\nconst envelope=results=>({step_invocation_schema:1,completed:results.length,failed:0,results});\nconst cases=[\n ['sequence_missing',call('input_sequence',{ok:true})],\n ['sequence_false',call('input_sequence',{ok:true,action_sent:false})],\n ['verify_missing',call('act_and_verify',{ok:false,action_result:{ok:true}})],\n ['contradictory_attempt',call('macro_run',envelope([{...leaf(0),invocation_attempted:false}]))],\n ['nonprefix_step',call('macro_run',envelope([leaf(7)]))],\n ['out_of_order',call('macro_run',envelope([leaf(1),leaf(0)]))],\n ['outer_unknown',call('macro_run',{...envelope([leaf(0)]),outcome:'unknown',action_sent:false})],\n ['outer_not_dispatched_conflict',call('macro_run',{...envelope([leaf(0)]),outcome:'not_dispatched'})]\n].map(([name,input])=>({name,input,output:project(input,true)}));\nconst get=name=>cases.find(x=>x.name===name).output;\nfor(const name of ['sequence_missing','sequence_false','verify_missing']) if(get(name).items[0]?.effectStatus!=='unknown') throw new Error(name);\nfor(const name of ['contradictory_attempt','nonprefix_step','out_of_order','outer_not_dispatched_conflict']) if(!get(name).incomplete||!get(name).items.some(x=>x.effectStatus==='unknown')) throw new Error(name);\nif(get('outer_unknown').items.map(x=>x.effectStatus).join(',')!=='reported,unknown') throw new Error('outer_unknown');\nconst longIdItems=['x'.repeat(120)+'A','x'.repeat(120)+'B'].map(id=>project(call('input_sequence',positives,id),true).items[0]);\nif(longIdItems.some(x=>x.callId)||longIdItems[0].callIdHash===longIdItems[1].callIdHash) throw new Error('long IDs');\nconst cap=summary(1,Array.from({length:51},()=>({name:'script_run',result:{ok:true}})),'openai',[]);\nif(cap.irreversible.length!==50||cap.irreversibleIncomplete!==true) throw new Error('global cap');\nconsole.log(JSON.stringify({sourceSha256:crypto.createHash('sha256').update(src).digest('hex'),pureSourceFunctionsOnly:true,serverNotLoaded:true,allAssertionsPassed:true,cases,longIdItems,globalCap:{rows:cap.irreversible.length,incomplete:cap.irreversibleIncomplete}},null,2));\nJS",
