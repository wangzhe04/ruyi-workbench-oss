
test('target binding scope connects the actual Store to owned captured Tree grants',async t=>{
  const f=await fixture(t),file=await f.put('migrations/skill-backup-bindings-v2.sealed','{}'),other=await f.put('migrations/other.sealed','{}');
  const host={file:()=>file,purpose:'backup',schema:1,scopeId:'binding',recordId:'binding',keys:f.keys,enabled:()=>true,writeJson:f.actual.atomicWriteJson};
  await loadWorkDataJournals().store.createText(host).write('{"ready":true}');const target=await f.reader.capture(f.source),src=fs.readFileSync(path.join(rootDir,'01ad-work-data-migration-host.js'),'utf8'),m=src.match(/    const targetBindingScope=(.+);\r?\n    async function prepare/);assert.ok(m);
  const getScope=(capture,owner=f.owner)=>vm.runInNewContext('('+m[1]+')',{WorkDataTree:f.api.tree,ownership:owner,p:path,key:s=>path.resolve(s).toLowerCase(),fail:code=>{throw Object.assign(Error(code),{code})}})(capture,'expected');
  const selected=getScope(target);try{
    const value=await selected('expected',grant=>f.actual.store.createText({...host,capturedFile:grant(file)}).read());assert.equal(value,'{"ready":true}');assert.equal(f.state.sourceIO,0);
    assert.throws(()=>selected('other',()=>{}),/candidate_invalid/);
    await assert.rejects(selected('expected',grant=>grant(other)()),/candidate_invalid/);
    await assert.rejects(getScope({...target})('expected',()=>{}),/captured_file_invalid/);
    await assert.rejects(getScope(target,{...f.owner})('expected',()=>{}),/captured_file_invalid/);
  }finally{target.release();}
  await assert.rejects(selected('expected',()=>{}),/snapshot_unavailable/);
  assert.equal(f.state.sourceIO,0);
});
