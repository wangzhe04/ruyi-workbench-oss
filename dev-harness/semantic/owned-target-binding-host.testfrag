
test('ordinary publication reads selected binding via the captured target scope',async t=>{const f=await fixture(t,{preserved:true});await f.write('config.json','{}');await f.write('sessions/one.json','{"id":"one"}');const expected=await f.manifest.readActive(),backup=await f.backupFirst(),token=await f.host.prepare({...backup,expected,targetMode:'encrypted'});assert.equal(f.state.bindingScopeCalls||0,0);await f.host.publish(token);assert.equal(f.state.bindingScopeCalls,2);const proof=await f.host.verifyPublished(token);assert.equal(f.state.bindingScopeCalls,3);assert.equal(proof.generation,1);});
