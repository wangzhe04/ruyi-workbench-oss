  // Research-only additional candidate proof: never replaces source guards.
  static bool ResearchKeys(Dictionary<string,object> value,string[] keys) {if(value==null||value.Count!=keys.Length)return false;foreach(string key in keys)if(!value.ContainsKey(key))return false;return true;}
  static void ResearchVerifyCandidateProof(Dictionary<string,object> args,Dictionary<string,object> snapshot) {
    object raw=null;if(!args.TryGetValue("candidateProof",out raw))return;
    var proof=Dict(raw);if(!ResearchKeys(proof,new string[]{"rootRel","rootId","entries"}))Reject("research_candidate_proof_shape");
    string root=Str(proof["rootRel"]),rootId=Str(proof["rootId"]);if(!System.Text.RegularExpressions.Regex.IsMatch(root,@"^\.work-data/generations/[a-f0-9]{48}$")||!System.Text.RegularExpressions.Regex.IsMatch(rootId,"^[a-f0-9]{24}$"))Reject("research_candidate_proof_shape");
    object[] wanted=proof["entries"] as object[];if(wanted==null||wanted.Length<1||wanted.Length>10000)Reject("research_candidate_proof_shape");
    var actual=new Dictionary<string,Dictionary<string,object>>(StringComparer.OrdinalIgnoreCase);
    foreach(object item in (IEnumerable)snapshot["entries"]) {var row=Dict(item);string rel=Str(row["rel"]);if(rel==root||rel.StartsWith(root+"/",StringComparison.OrdinalIgnoreCase)){string local=rel==root?"":rel.Substring(root.Length+1);if(actual.ContainsKey(local))Reject("research_candidate_proof_namespace");actual.Add(local,row);}}
    if(actual.Count!=wanted.Length||!actual.ContainsKey("")||Str(actual[""]["id"])!=rootId)Reject("research_candidate_proof_namespace");
    var seen=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach(object item in wanted) {var expect=Dict(item);if(!ResearchKeys(expect,new string[]{"rel","id","dir","attrs","shortName","times","streams"}))Reject("research_candidate_proof_shape");string rel=Str(expect["rel"]);if(!seen.Add(rel)||!actual.ContainsKey(rel))Reject("research_candidate_proof_namespace");var got=actual[rel];string actualRel=Str(got["rel"]);string local=actualRel==root?"":actualRel.Substring(root.Length+1);if(!String.Equals(local,rel,StringComparison.Ordinal)||Str(got["id"])!=Str(expect["id"])||!(expect["dir"] is bool)||(bool)got["dir"]!=(bool)expect["dir"]||Convert.ToUInt32(got["attrs"])!=Convert.ToUInt32(expect["attrs"])||!String.Equals(Str(got["shortName"]),Str(expect["shortName"]),StringComparison.Ordinal))Reject("research_candidate_proof_identity");
      var et=expect["times"] as object[];if(et==null||et.Length!=4)Reject("research_candidate_proof_shape");var at=new List<string>();foreach(object t in (IEnumerable)got["times"])at.Add(Str(t));if(at.Count!=4)Reject("research_candidate_proof_shape");for(int i=0;i<4;i++)if(!(et[i] is string)||Str(et[i])!=at[i])Reject("research_candidate_proof_metadata");
      var streams=new Dictionary<string,Dictionary<string,object>>(StringComparer.OrdinalIgnoreCase);foreach(object s in (IEnumerable)got["streams"]){var row=Dict(s);string name=Str(row["name"]);if(streams.ContainsKey(name))Reject("research_candidate_proof_streams");streams.Add(name,row);}object[] expectedStreams=expect["streams"] as object[];if(expectedStreams==null||expectedStreams.Length!=streams.Count)Reject("research_candidate_proof_streams");var names=new HashSet<string>(StringComparer.OrdinalIgnoreCase);
      foreach(object s in expectedStreams){var row=Dict(s);if(!ResearchKeys(row,new string[]{"name","size","hash"}))Reject("research_candidate_proof_shape");string name=Str(row["name"]),hash=Str(row["hash"]);if(!names.Add(name)||!streams.ContainsKey(name)||!String.Equals(Str(streams[name]["name"]),name,StringComparison.Ordinal)||!System.Text.RegularExpressions.Regex.IsMatch(hash,"^[a-f0-9]{64}$")||Convert.ToInt64(row["size"])<0||Convert.ToInt64(streams[name]["size"])!=Convert.ToInt64(row["size"])||Str(streams[name]["hash"])!=hash)Reject("research_candidate_proof_streams");}
    }
  }
