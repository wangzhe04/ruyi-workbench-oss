  // Research candidate capability. Root and child handles remain open with
  // share-delete for compatibility; parent chains are pinned only per operation.
  static string ResearchCandidateBase=null,ResearchCandidateRoot=null,ResearchCandidateToken=null;
  static string[] ResearchAnchorParts=null,ResearchAnchorIds=null;static int ResearchCandidateFlushCalls=0;
  static readonly Dictionary<string,SafeFileHandle> ResearchCandidateHandles=new Dictionary<string,SafeFileHandle>(StringComparer.OrdinalIgnoreCase);
  static readonly Dictionary<string,string> ResearchCandidateIds=new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase);
  static string ResearchObjectId(SafeFileHandle h) {Info i;Check(GetFileInformationByHandle(h,out i));if((i.Attr&16u)==0||(i.Attr&0x400u)!=0)Reject("research_candidate_alias");return i.Volume.ToString("x8")+i.IndexHigh.ToString("x8")+i.IndexLow.ToString("x8");}
  static void ResearchCheck(SafeFileHandle h,string expected,string id) {if(ResearchObjectId(h)!=id||!String.Equals(PathOf(h),NativePath(expected),StringComparison.OrdinalIgnoreCase))Reject("research_candidate_changed");}
  static bool ResearchPart(string part) {return !String.IsNullOrEmpty(part)&&part!="."&&part!=".."&&part.Length<=255&&part.IndexOfAny(new char[]{'\\','/',':','\0','\r','\n'})<0;}
  static SafeFileHandle ResearchRelativeOpen(SafeFileHandle parent,string part,uint access,uint share,uint disposition) {
    if(!ResearchPart(part))Reject("research_candidate_name");
    IntPtr buf=Marshal.StringToHGlobalUni(part),name=Marshal.AllocHGlobal(Marshal.SizeOf(typeof(RelativeName))),iosb=Marshal.AllocHGlobal(IntPtr.Size*2);SafeFileHandle h=null;
    try {var u=new RelativeName{Length=(ushort)(part.Length*2),MaximumLength=(ushort)((part.Length+1)*2),Buffer=buf};Marshal.StructureToPtr(u,name,false);
      var a=new RelativeAttributes{Length=(uint)Marshal.SizeOf(typeof(RelativeAttributes)),RootDirectory=parent.DangerousGetHandle(),ObjectName=name,Attributes=0x40};
      int status=NtCreateFile(out h,access,ref a,iosb,IntPtr.Zero,0,share,disposition,0x00204021u,IntPtr.Zero,0);
      if(status<0)throw new Win32Exception((int)RtlNtStatusToDosError(status));if(status!=0||h==null||h.IsInvalid)Reject("research_candidate_open");
      SafeFileHandle result=h;h=null;return result;
    }finally{if(h!=null)h.Dispose();GC.KeepAlive(parent);Marshal.FreeHGlobal(buf);Marshal.FreeHGlobal(name);Marshal.FreeHGlobal(iosb);}
  }
  static void ResearchClosePins(List<SafeFileHandle> pins) {for(int i=pins.Count-1;i>=0;i--)pins[i].Dispose();}
  static List<SafeFileHandle> ResearchPinCandidate(string relative,uint finalAccess) {
    if(ResearchCandidateBase==null)Reject("research_candidate_inactive");var pins=new List<SafeFileHandle>();
    try {
      string drive=System.IO.Path.GetPathRoot(ResearchCandidateBase),current=drive;var root=CreateFile(NativePath(drive),0x001000a0u,3,IntPtr.Zero,3,0x02200000u,IntPtr.Zero);if(root.IsInvalid){int e=Marshal.GetLastWin32Error();root.Dispose();throw new Win32Exception(e);}pins.Add(root);ResearchCheck(root,current,ResearchAnchorIds[0]);SafeFileHandle parent=root;
      for(int i=0;i<ResearchAnchorParts.Length;i++){current=System.IO.Path.Combine(current,ResearchAnchorParts[i]);bool last=i==ResearchAnchorParts.Length-1&&relative==null;uint access=last?finalAccess:0x001000a0u;var child=ResearchRelativeOpen(parent,ResearchAnchorParts[i],access,3,1);pins.Add(child);ResearchCheck(child,current,ResearchAnchorIds[i+1]);parent=child;}
      if(relative!=null){string[] parts=relative==""?new string[0]:relative.Split('/');string key="";current=ResearchCandidateRoot;var candidate=ResearchRelativeOpen(parent,System.IO.Path.GetFileName(ResearchCandidateRoot),parts.Length==0?finalAccess:0x001000a0u,3,1);pins.Add(candidate);ResearchCheck(candidate,current,ResearchCandidateIds[""]);parent=candidate;
        for(int i=0;i<parts.Length;i++){if(!ResearchPart(parts[i]))Reject("research_candidate_name");key=key==""?parts[i]:key+"/"+parts[i];string id;if(!ResearchCandidateIds.TryGetValue(key,out id))Reject("research_candidate_unowned");current=System.IO.Path.Combine(current,parts[i]);var child=ResearchRelativeOpen(parent,parts[i],i==parts.Length-1?finalAccess:0x001000a0u,3,1);pins.Add(child);ResearchCheck(child,current,id);parent=child;}}
      return pins;
    }catch{ResearchClosePins(pins);throw;}
  }
  static object ResearchCandidateStart(Dictionary<string,object> args) {
    if(ResearchCandidateBase!=null||ResearchCandidateHandles.Count!=0)Reject("research_candidate_busy");string basis=Str(args["base"]),id=Str(args["id"]);object[] ids=args["anchorIds"] as object[];
    if(basis.Length<4||!Char.IsLetter(basis[0])||basis[1]!=':'||basis[2]!='\\'||!String.Equals(System.IO.Path.GetFullPath(basis),basis,StringComparison.OrdinalIgnoreCase)||!System.Text.RegularExpressions.Regex.IsMatch(id,"^[a-f0-9]{48}$"))Reject("research_candidate_scope");
    string drive=System.IO.Path.GetPathRoot(basis),suffix=basis.Substring(drive.Length);var parts=new List<string>();foreach(string part in suffix.Split('\\')){if(!ResearchPart(part))Reject("research_candidate_name");parts.Add(part);}parts.Add(".work-data");parts.Add("generations");
    if(ids==null||ids.Length!=parts.Count+1)Reject("research_candidate_anchor");var expected=new string[ids.Length];for(int i=0;i<ids.Length;i++){if(!(ids[i] is string)||!System.Text.RegularExpressions.Regex.IsMatch((string)ids[i],"^[a-f0-9]{24}$"))Reject("research_candidate_anchor");expected[i]=(string)ids[i];if(i>0&&expected[i].Substring(0,8)!=expected[0].Substring(0,8))Reject("research_candidate_volume");}
    ResearchCandidateBase=basis;ResearchCandidateRoot=System.IO.Path.Combine(basis,".work-data","generations",id);ResearchAnchorParts=parts.ToArray();ResearchAnchorIds=expected;ResearchCandidateToken=RandomName();ResearchCandidateFlushCalls=0;
    List<SafeFileHandle> pins=null;SafeFileHandle created=null;
    try {pins=ResearchPinCandidate(null,0x001000a4u);var parent=pins[pins.Count-1];created=ResearchRelativeOpen(parent,id,0xC0100100u,7,2);ResearchCandidateHandles.Add("",created);created=null;var held=ResearchCandidateHandles[""];string childId=ResearchObjectId(held);ResearchCandidateIds.Add("",childId);ResearchCheck(held,ResearchCandidateRoot,childId);for(int i=0;i<pins.Count;i++){string current=drive;for(int j=0;j<i;j++)current=System.IO.Path.Combine(current,ResearchAnchorParts[j]);ResearchCheck(pins[i],current,ResearchAnchorIds[i]);}StoreFileSystem(held);
      return new Dictionary<string,object>{{"kind","candidate-directory-created-v1"},{"token",ResearchCandidateToken},{"root",ResearchCandidateRoot},{"relative",""},{"id",childId},{"parentId",null},{"created",true}};
    }finally{if(created!=null)created.Dispose();if(pins!=null)ResearchClosePins(pins);}
  }
  static void ResearchCandidateAuth(Dictionary<string,object> args) {if(ResearchCandidateBase==null||Str(args["token"])!=ResearchCandidateToken||!String.Equals(Str(args["root"]),ResearchCandidateRoot,StringComparison.OrdinalIgnoreCase))Reject("research_candidate_binding");}
  static object ResearchCandidateMkdir(Dictionary<string,object> args) {
    ResearchCandidateAuth(args);string relative=Str(args["relative"]);int at=relative.LastIndexOf('/');string parentRel=at<0?"":relative.Substring(0,at),part=at<0?relative:relative.Substring(at+1);if(!ResearchPart(part)||ResearchCandidateIds.ContainsKey(relative)||!ResearchCandidateIds.ContainsKey(parentRel)||Str(args["parentId"])!=ResearchCandidateIds[parentRel])Reject("research_candidate_scope");
    var pins=ResearchPinCandidate(parentRel,0x001000a4u);SafeFileHandle created=null;
    try {created=ResearchRelativeOpen(pins[pins.Count-1],part,0xC0100100u,7,2);ResearchCandidateHandles.Add(relative,created);created=null;var held=ResearchCandidateHandles[relative];string id=ResearchObjectId(held),expected=System.IO.Path.Combine(ResearchCandidateRoot,relative.Replace('/','\\'));ResearchCandidateIds.Add(relative,id);ResearchCheck(held,expected,id);StoreFileSystem(held);return new Dictionary<string,object>{{"kind","candidate-directory-created-v1"},{"token",ResearchCandidateToken},{"root",ResearchCandidateRoot},{"relative",relative},{"id",id},{"parentId",ResearchCandidateIds[parentRel]},{"created",true}};}
    finally{if(created!=null)created.Dispose();ResearchClosePins(pins);}
  }
  static object ResearchCandidateFlush(Dictionary<string,object> args) {
    ResearchCandidateAuth(args);object[] entries=args["dirs"] as object[];if(entries==null||entries.Length!=ResearchCandidateIds.Count)Reject("research_candidate_namespace");var seen=new HashSet<string>(StringComparer.OrdinalIgnoreCase);var rows=new List<object>();
    foreach(object raw in entries){var row=Dict(raw);string relative=Str(row["relative"]),id=Str(row["id"]),owned;if(!seen.Add(relative)||!ResearchCandidateIds.TryGetValue(relative,out owned)||id!=owned)Reject("research_candidate_namespace");rows.Add(new Dictionary<string,object>{{"relative",relative},{"id",id}});}
    var flushRows=new List<object>(rows);flushRows.Sort(delegate(object left,object right){string a=Str(Dict(left)["relative"]),b=Str(Dict(right)["relative"]);int da=a==""?0:a.Split('/').Length,db=b==""?0:b.Split('/').Length;int byDepth=db.CompareTo(da);return byDepth!=0?byDepth:StringComparer.Ordinal.Compare(a,b);});
    foreach(object raw in flushRows){var row=Dict(raw);string relative=Str(row["relative"]),id=Str(row["id"]),expected=relative==""?ResearchCandidateRoot:System.IO.Path.Combine(ResearchCandidateRoot,relative.Replace('/','\\'));var pins=ResearchPinCandidate(relative,0xC0100100u);try{var h=pins[pins.Count-1];ResearchCheck(h,expected,id);ResearchCandidateFlushCalls++;Check(FlushFileBuffers(h));ResearchCheck(h,expected,id);ResearchCheck(ResearchCandidateHandles[relative],expected,id);}finally{ResearchClosePins(pins);}}
    return new Dictionary<string,object>{{"kind","candidate-directory-flush-v1"},{"root",ResearchCandidateRoot},{"token",ResearchCandidateToken},{"dirs",rows},{"flushed",true}};
  }
  static object ResearchCandidateStats(Dictionary<string,object> args) {ResearchCandidateAuth(args);return new Dictionary<string,object>{{"flushCalls",ResearchCandidateFlushCalls}};}
  static object ResearchCandidateOpenCompat(Dictionary<string,object> args) {string root=Str(args["root"]),id=Str(args["id"]);using(var h=Open(root)){if(ResearchObjectId(h)!=id||!String.Equals(PathOf(h),NativePath(root),StringComparison.OrdinalIgnoreCase))Reject("research_candidate_changed");return new Dictionary<string,object>{{"ok",true},{"id",id}};}}
  static object ResearchCandidateClose(Dictionary<string,object> args) {ResearchCandidateAuth(args);foreach(var h in ResearchCandidateHandles.Values)h.Dispose();ResearchCandidateHandles.Clear();ResearchCandidateIds.Clear();ResearchCandidateBase=null;ResearchCandidateRoot=null;ResearchCandidateToken=null;ResearchAnchorParts=null;ResearchAnchorIds=null;return new Dictionary<string,object>{{"closed",true}};}
