  // A pre-issuance candidate-only preflight. Basic time values here are NOT a
  // signed target proof; the ordinary CapturePreserved remains unchanged later.
  static bool CandidateSettlementCapture=false;static string CandidateSettlementRoot=null;
  static object CandidateSettleRoot(Dictionary<string,object> args) {
    if(Nodes.Count!=0||Snapshot!=null||OriginalRoot!=null||PreserveTimeHandles||CandidateSettlementCapture)Reject("candidate_settle_scope");
    string basis=Str(args["base"]),root=Str(args["root"]),rootId=Str(args["id"]),revision=Str(args["revision"]);
    object[] parentIds=args["parents"] as object[],files=args["files"] as object[],dirs=args["directories"] as object[];
    string full=System.IO.Path.GetFullPath(basis),parent=System.IO.Path.Combine(full,".work-data","generations");
    if(args.Count!=8||!String.Equals(full,basis,StringComparison.OrdinalIgnoreCase)||!String.Equals(System.IO.Path.GetFullPath(root),root,StringComparison.OrdinalIgnoreCase)||!String.Equals(System.IO.Path.GetDirectoryName(root),parent,StringComparison.OrdinalIgnoreCase)||
       !System.Text.RegularExpressions.Regex.IsMatch(System.IO.Path.GetFileName(root),"^[a-f0-9]{48}$")||!System.Text.RegularExpressions.Regex.IsMatch(rootId,"^[a-f0-9]{24}$")||!System.Text.RegularExpressions.Regex.IsMatch(revision,"^[a-f0-9]{64}$")||parentIds==null||parentIds.Length!=3||files==null||dirs==null||files.Length>10000||dirs.Length>10000)Reject("candidate_settle_scope");
    foreach(object id in parentIds)if(!(id is string)||!System.Text.RegularExpressions.Regex.IsMatch((string)id,"^[a-f0-9]{24}$"))Reject("candidate_settle_scope");
    var expectedFiles=new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase);var expectedDirs=new HashSet<string>(StringComparer.OrdinalIgnoreCase);expectedDirs.Add("");
    foreach(object item in files){var row=Dict(item);if(row.Count!=2||!row.ContainsKey("path")||!row.ContainsKey("sha256"))Reject("candidate_settle_plan");string name=Str(row["path"]),digest=Str(row["sha256"]);if(String.IsNullOrEmpty(name)||!System.Text.RegularExpressions.Regex.IsMatch(digest,"^[a-f0-9]{64}$"))Reject("candidate_settle_plan");foreach(string part in name.Split('/'))if(!FlushPart(part))Reject("candidate_settle_plan");if(expectedFiles.ContainsKey(name))Reject("candidate_settle_plan");expectedFiles.Add(name,digest);}
    foreach(object item in dirs){string name=Str(item);if(String.IsNullOrEmpty(name))Reject("candidate_settle_plan");foreach(string part in name.Split('/'))if(!FlushPart(part))Reject("candidate_settle_plan");if(!expectedDirs.Add(name))Reject("candidate_settle_plan");}
    var pins=new List<SafeFileHandle>();var handles=new List<SafeFileHandle>();var addresses=new HashSet<IntPtr>();Exception primary=null;object result=null;
    bool previous=PreserveTimeHandles,previousWrite=CapturedDirectoryWrite;CandidateSettlementCapture=true;CandidateSettlementRoot=NativePath(root);PreserveTimeHandles=true;
    try {
      var first=CreateFile(NativePath(basis),0x00100080u,3,IntPtr.Zero,3,0x02200000u,IntPtr.Zero);if(first.IsInvalid){int error=Marshal.GetLastWin32Error();first.Dispose();throw new Win32Exception(error);}pins.Add(first);ResearchCheck(first,basis,(string)parentIds[0]);
      var second=ResearchRelativeOpen(first,".work-data",0x00100080u,3,1);pins.Add(second);ResearchCheck(second,System.IO.Path.Combine(basis,".work-data"),(string)parentIds[1]);
      var third=ResearchRelativeOpen(second,"generations",0x00100080u,3,1);pins.Add(third);ResearchCheck(third,parent,(string)parentIds[2]);
      var snapshot=Dict(Capture(new Dictionary<string,object>{{"root",root},{"revision",revision}}));ResearchCheck(RootNode().Handle,root,rootId);
      var actualFiles=new HashSet<string>(StringComparer.OrdinalIgnoreCase);var actualDirs=new HashSet<string>(StringComparer.OrdinalIgnoreCase);var rows=new List<object>();
      foreach(object raw in (IEnumerable)snapshot["entries"]){var entry=Dict(raw);string rel=Str(entry["rel"]),id=Str(entry["id"]);bool directory=(bool)entry["dir"];var streams=new List<object>();
        foreach(object streamRaw in (IEnumerable)entry["streams"]){var stream=Dict(streamRaw);string name=Str(stream["name"]);if(name!="")Reject("candidate_settle_stream");streams.Add(new Dictionary<string,object>{{"name",name},{"size",stream["size"]},{"hash",stream["hash"]}});}
        if(directory){if(streams.Count!=0||!expectedDirs.Contains(rel)||!actualDirs.Add(rel))Reject("candidate_settle_plan");}
        else{string expected;if(streams.Count!=1||!expectedFiles.TryGetValue(rel,out expected)||Str(Dict(streams[0])["hash"])!=expected||!actualFiles.Add(rel))Reject("candidate_settle_plan");}
        rows.Add(new Dictionary<string,object>{{"rel",rel},{"id",id},{"dir",directory},{"attrs",entry["attrs"]},{"shortName",entry["shortName"]},{"streams",streams}});
      }
      if(actualFiles.Count!=expectedFiles.Count||actualDirs.Count!=expectedDirs.Count)Reject("candidate_settle_plan");
      VerifyOriginalLayout();Verify(false,true);ResearchCheck(RootNode().Handle,root,rootId);Step="candidate-root-settlement";Check(FlushFileBuffers(RootNode().Handle));
      ResearchCheck(RootNode().Handle,root,rootId);VerifyOriginalLayout();Verify(false,true);
      foreach(Node node in Nodes.Values){Basic now=BasicOf(node.Handle);if(now.Attr!=Convert.ToUInt32(node.Entry["attrs"]))Reject("candidate_settle_attributes");}
      result=new Dictionary<string,object>{{"kind","candidate-root-settlement-v1"},{"id",rootId},{"root",root},{"rows",rows},{"rootFlushed",true}};
    }catch(Exception error){primary=error;throw;}
    finally {
      try {foreach(Node node in Nodes.Values){handles.Add(node.Handle);handles.AddRange(node.Streams.Values);}handles.AddRange(pins);foreach(SafeFileHandle h in handles)if(h.IsClosed||h.IsInvalid||!addresses.Add(h.DangerousGetHandle()))Reject("census_first_close_unverified");
        Close();for(int i=pins.Count-1;i>=0;i--)pins[i].Dispose();foreach(SafeFileHandle h in handles)if(!h.IsClosed)Reject("census_first_close_unverified");foreach(IntPtr value in addresses){uint flags;if(GetHandleInformation(value,out flags)||Marshal.GetLastWin32Error()!=6)Reject("census_first_close_unverified");}}
      catch(Exception error){throw new InvalidOperationException("census_first_close_unverified",primary??error);}
      finally{CandidateSettlementCapture=false;CandidateSettlementRoot=null;PreserveTimeHandles=previous;CapturedDirectoryWrite=previousWrite;}
    }
    return result;
  }
